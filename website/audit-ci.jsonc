{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // npm dependency CVE gate for the docs site: fails on high/critical, reports
  // the rest. Same thresholds as the other scanners (see
  // .github/workflows/security.yml). Every allowlist entry needs a comment and
  // a removal condition; no silent suppression. Nothing is allowlisted today.
  "high": true,
  "allowlist": []
}

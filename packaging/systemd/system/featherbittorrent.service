# Example systemd system service for `featherbittorrent serve`.
# Nothing installs or enables this file: it ships as documentation under
# /usr/share/doc/featherbittorrent/examples/, and copying it to /etc/systemd/system/ and running
# `systemctl enable` yourself is the whole installation. docs/autostart.md walks through it, including
# the user account this unit expects (`useradd --system ... featherbittorrent`) and what to do on a
# machine whose downloads live on a NAS.
[Unit]
Description=featherbittorrent server
Documentation=man:featherbittorrent-serve(1) file:///usr/share/doc/featherbittorrent/autostart.md
Wants=network-online.target
After=network-online.target remote-fs.target
# Uncomment this (and name your mount) when downloads go to a network share, so the server starts once
# the mount is up instead of finding a missing folder. It pairs with `_netdev` in /etc/fstab.
# RequiresMountsFor=/mnt/nas/torrents

[Service]
Type=exec
User=featherbittorrent
Group=featherbittorrent
# The library this service owns, apart from any person's own directories on the same machine: a server
# rewrites its own config.yaml when a device is added from a laptop, so it lives where that account can
# write. A user service leaves both unnamed and shares the platform's directories with the TUI instead.
Environment=FBTT_CONFIG_DIR=/var/lib/featherbittorrent/config
Environment=FBTT_DATA_DIR=/var/lib/featherbittorrent/library
ExecStart=/usr/bin/featherbittorrent serve
# Closed stdin, so the setup wizard can never wait for an answer a service has nobody to give: with no
# config.yaml this run takes every default rather than blocking. Run `serve` once by hand first, or
# write the file, and the questions do not come up at all.
StandardInput=null
Restart=on-failure
RestartSec=10
# How long SIGTERM gets before systemd sends SIGKILL. SIGTERM is what runs the last save, and a large
# library on a NAS is the case that takes a while, so this says the grace out loud instead of leaving it
# to whatever the default happens to be on the systemd in front of it.
TimeoutStopSec=90
StateDirectory=featherbittorrent
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/featherbittorrent
# Uncomment this too, with the same mount point as RequiresMountsFor above: ProtectSystem=strict makes
# everything outside the paths below read-only, and a download folder on a NAS is one of them.
# ReadWritePaths=/mnt/nas/torrents

[Install]
# Only used by `systemctl enable`. Installing the package writes nothing here.
WantedBy=multi-user.target
